# Copy to .env (never commit .env). Every value optional except where a command says otherwise.
# ANTHROPIC_API_KEY=            # Claude turns the scraped facts into a marketing brief + writes the Fudge guide (optional but recommended)
# ANTHROPIC_MODEL=claude-opus-5
# Higgsfield has two routes; pdp.py supports both (HIGGSFIELD_BACKEND=api|cli, default api when HF_KEY is set, else cli):
#   api = developer API on platform.higgsfield.ai, pay-per-use key from https://cloud.higgsfield.ai
#   cli = the `higgsfield` CLI on your normal Higgsfield account (`higgsfield auth login`), with product-photoshoot
# HF_KEY=key:secret             # api backend (or HF_API_KEY + HF_API_SECRET)
# HIGGSFIELD_BACKEND=cli
# HIGGSFIELD_CLI_MODEL=nano_banana_2            # cli backend model id (`higgsfield model list --json`); `generate --photoshoot <mode>` ignores it
# HIGGSFIELD_CLI_EXTRA=                         # extra flags appended verbatim to every CLI call
# HIGGSFIELD_MODEL=openai/gpt-image-2/edit   # model id that accepts reference images; check the model page on cloud.higgsfield.ai
# HIGGSFIELD_IMAGE_ARG=image_urls               # request field that carries the reference URLs for that model
# HIGGSFIELD_NUM_IMAGES=4 / HIGGSFIELD_ASPECT=1:1 / HIGGSFIELD_RESOLUTION=2K / HIGGSFIELD_MAX_REFS=6
# HIGGSFIELD_EXTRA_ARGS={"seed": 42}            # JSON merged into every request
# SHOPIFY_STORE=my-brand.myshopify.com          # the *.myshopify.com domain, not the custom domain
# Dev Dashboard app (README > PDP cloner > Shopify app): Client ID + Client secret; pdp.py mints the 24 h token itself
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ADMIN_TOKEN=shpat_...                 # only for a legacy admin-created app (token shown once); leave empty otherwise
# SHOPIFY_API_VERSION=2025-07
# SHOPIFY_TOKEN_CACHE=data/shopify_token.json   # where the minted token is cached (gitignored)
# BRAND_NAME=SoleneLife                        # replaces the competitor's brand in product titles (Shopify title, image folder, {title})
# BRAND_SUFFIX=                                # set e.g. 'by SoleneLife' to append instead of prefixing
# PDP_GRAB_ALL_IMAGES=0                        # 1 = also save the page's non-gallery images (default: gallery only)
# PDP_TEMPLATE=templates/universal_pdp_template.md   # the Universal PDP Template (converted from the PDF) used by `guide`
# PDP_OUTPUT_DIR=pdp_output                     # where each product folder is created

# USER_AGENT=                   # override the browser User-Agent used for competitor pages
